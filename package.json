{
  "name": "sparkforensics",
  "version": "0.24.1",
  "description": "Zero-backend browser dashboard that parses Apache Spark event logs to diagnose performance bottlenecks: skew, spill, GC pressure, stragglers, cache utilization, and more.",
  "private": true,
  "type": "module",
  "workspaces": [
    ".",
    "packages/*"
  ],
  "license": "MIT",
  "author": "Agustin Recoba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuffle-works/sparkforensics.git"
  },
  "bugs": {
    "url": "https://github.com/shuffle-works/sparkforensics/issues"
  },
  "homepage": "https://github.com/shuffle-works/sparkforensics#readme",
  "keywords": [
    "apache-spark",
    "spark",
    "spark-history-server",
    "performance",
    "diagnostics",
    "observability",
    "event-log",
    "dashboard",
    "query-plan"
  ],
  "engines": {
    "node": ">=22.18.0 <23.0.0 || >=23.6.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:core": "npm run test:coverage --workspace packages/core",
    "test:cli": "npm run test:coverage --workspace packages/cli",
    "test:mcp": "npm run test:coverage --workspace packages/mcp",
    "test:server": "npm test --workspace packages/server",
    "lint": "eslint .",
    "release": "node scripts/publish-packages.mjs",
    "local-server": "node packages/server/index.js",
    "capture-components": "node dev/component-capture/capture.mjs",
    "update-docs": "node scripts/update-docs.mjs",
    "doc-anchor-coverage": "node scripts/doc-anchor-coverage.js",
    "split-detection-docs": "node scripts/split-detection-docs.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "build": "npm run docs:build && vite build",
    "build:export": "DOCS_MPA=1 npm run docs:build && vite build --config vite.export.config.ts",
    "preview": "vite preview",
    "docs:dev": "node scripts/build-tuning-reference.mjs && vitepress dev docs-site",
    "docs:build": "node scripts/build-tuning-reference.mjs && vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.7.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "js-yaml": "^5.4.1",
    "jsdom": "^29.1.1",
    "markdown-it-footnote": "^4.0.0",
    "playwright": "^1.62.1",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitepress": "^1.6.4",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sparkforensics/core": "*",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.14"
  }
}
