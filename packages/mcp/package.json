{
  "name": "sparkforensics-mcp",
  "version": "0.12.1",
  "mcpName": "io.github.shuffle-works/sparkforensics-mcp",
  "type": "module",
  "license": "FSL-1.1-MIT",
  "description": "MCP server exposing Apache Spark event-log diagnostics over stdio.",
  "repository": {
