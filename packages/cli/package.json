{
  "name": "sparkforensics-cli",
  "version": "0.11.0",
  "type": "module",
  "license": "MIT",
  "description": "CLI to analyze Apache Spark event logs for performance bottlenecks: skew, spill, GC pressure, stragglers, and more.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuffle-works/sparkforensics.git"
  },
  "bugs": {
    "url": "https://github.com/shuffle-works/sparkforensics/issues"
  },
  "homepage": "https://github.com/shuffle-works/sparkforensics#readme",
  "keywords": [
    "apache-spark",
    "spark",
    "spark-history-server",
    "cli",
    "performance",
    "diagnostics",
    "event-log"
  ],
  "bin": {
    "sparkforensics-analyze": "bin/sparkforensics-analyze.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "bin/",
    "schema/",
    "vendor-core/",
    "export-template/"
  ],
  "scripts": {
    "prepack": "node ../../scripts/vendor-core.mjs . && node ../../scripts/vendor-export-template.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sparkforensics/core": "*",
    "ajv": "^8.20.0",
    "vitest": "^5.0.3"
  }
}
